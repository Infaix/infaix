# Production session cookie scope: Domain + SameSite=None lets the cookie
# travel between infaix.com and ai.infaix.com (always Secure + HttpOnly).
# Non-production keeps host-only SameSite=Lax cookies (localhost-safe).
# COOKIE_DOMAIN=.infaix.com

# Extra CORS origins for /api/* (additive, comma-separated). Production
# entries must be https; the defaults already cover https://infaix.com and
# https://ai.infaix.com. Example: CORS_EXTRA_ORIGINS=https://preview.infaix.com
# CORS_EXTRA_ORIGINS=

# --- INFAIX AI bridge (main Worker -> InfaixAI gateway) ---
# The browser calls same-origin /api/ai/* only. Direct inference URLs are
# intentionally unsupported — the Worker proxies to AI_GATEWAY_URL.
# AI_GATEWAY_URL=https://ai.infaix.com

# Required: HMAC secret shared ONLY with the InfaixAI gateway (min 32 chars).
# Set with `wrangler secret put AI_GATEWAY_SECRET`. Never exposed to browsers.
# Generate: openssl rand -hex 32
# AI_GATEWAY_SECRET=

# Previous secret, accepted during rotation only. Set during rotation, then remove.
# AI_GATEWAY_SECRET_PREVIOUS=

# Expected assertion audience (default: ai.infaix.com).
# AI_GATEWAY_AUDIENCE=ai.infaix.com

# AI chat abuse protection: per-user hourly and per-IP minutely budgets.
# AI_CHAT_USER_LIMIT=60
# AI_CHAT_USER_WINDOW=3600
# AI_CHAT_IP_LIMIT=10
# AI_CHAT_IP_WINDOW=60

# Upstream timeout in ms for gateway inference (1000-600000, default 120000).
# AI_UPSTREAM_TIMEOUT_MS=120000

# --- INFAIX account system (Cloudflare Worker + D1) ---
# These are read by the Worker. Set secrets with `wrangler secret put <NAME>`
# (see docs/auth.md). NEVER commit real values — this file holds placeholders only.

# Required: HMAC secret for session cookies (min 32 chars). Generate:
#   openssl rand -hex 32
# SESSION_SECRET=

# One-time operator token for seeding the first admin invites via
# POST /api/admin/invites (header: x-admin-token). Remove/rotate after use.
# ADMIN_BOOTSTRAP_TOKEN=

# deployment | development | test. Dev/test routes reset links through the
# local email outbox; production requires a mail provider (see docs/auth.md).
# ENVIRONMENT=development

# Public origin used to build reset/verification links (defaults to request origin).
# APP_ORIGIN=https://infaix.com

# Password hashing cost (PBKDF2-SHA256 iterations, 50000-2000000, default 210000).
# PBKDF2_ITERATIONS=210000

# Rate limits: <endpoint> max attempts per window (seconds). Defaults shown.
# RL_LOGIN_LIMIT=10
# RL_LOGIN_WINDOW=600
# RL_REGISTER_LIMIT=10
# RL_REGISTER_WINDOW=3600
# RL_RESET_LIMIT=5
# RL_RESET_WINDOW=3600
# RL_VERIFY_LIMIT=10
# RL_VERIFY_WINDOW=3600
# RL_ADMIN_LIMIT=30
# RL_ADMIN_WINDOW=3600
