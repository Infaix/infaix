{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infaix-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Account API (D1 + Web Crypto). Create the database once, then replace
  // database_id below:
  //   wrangler d1 create infaix-db
  //   wrangler d1 execute infaix-db --file=db/migrations/0001_init.sql
  // Secrets are NEVER stored here — set them with:
  //   wrangler secret put SESSION_SECRET        # openssl rand -hex 32 (min 32 chars)
  //   wrangler secret put ADMIN_BOOTSTRAP_TOKEN # openssl rand -hex 32 (one-time seeding, then remove)
  "d1_databases": [
    {
      "binding": "INFAIX_DB",
      "database_name": "infaix-db",
      "database_id": "96eeae47-31ff-4e9f-8a22-0db9b89cdf32"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "main": "worker/index.ts"
}
